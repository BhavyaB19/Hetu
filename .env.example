# Copy to .env. Never commit .env.

# TinyFish web agents: collect judgments, news coverage and public comments.
TINYFISH_API_KEY=
# true = never call TinyFish; replay collections cached in backend/fixtures/collected/.
USE_FIXTURES=false

# LLM that extracts structured data from collected documents: groq, openai or anthropic.
# Only this provider is used, and only its key below needs to be set.
LLM_PROVIDER=groq

# Groq (open-weight models).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# free (default): about 8,000 tokens/minute, so long judgments are read in chunks and
# calls are paced (slow, ~20 minutes for a long judgment). developer: one call per document.
# GROQ_PLAN=free

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Database: PostgreSQL is used everywhere (start with `docker compose up -d postgres redis`).
DATABASE_URL=postgresql+asyncpg://hetu:hetu@localhost:5433/hetu
TEST_DATABASE_URL=postgresql+asyncpg://hetu:hetu@localhost:5433/hetu_test
REDIS_URL=redis://localhost:6379

# Where the frontend server reaches the API.
# API_URL=http://127.0.0.1:8000
